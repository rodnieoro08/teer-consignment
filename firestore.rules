rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /units/{id} {
      allow read, write: if signedIn();
    }
    match /events/{id} {
      allow read, write: if signedIn();
    }
    match /hospitals/{id} {
      allow read, write: if signedIn();
    }
    match /presence/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == id;
    }
  }
}
